<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The cup body sits 1.5 units right of center so the handle stays inside the
         66dp adaptive-icon safe zone; the handle hangs off to the left.
         The group scales the whole glyph up around the center. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.38"
        android:scaleY="1.38">

        <!-- Cup body: top and base are the same width (28), sides curve in to a
             slightly narrower waist (25) at mid-height. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M41.5,36 L69.5,36 Q66.5,54 69.5,72 L41.5,72 Q44.5,54 41.5,36 Z" />

        <!-- Handle: a full semicircle loop on the left side, radius 10,
             ends tucked into the cup wall. -->
        <path
            android:pathData="M44.5,44 L42.5,44 A10,10 0 0,0 42.5,64 L44.5,64"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="butt"
            android:strokeLineJoin="round" />
    </group>
</vector>
